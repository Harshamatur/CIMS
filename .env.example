# Copy to .env (never commit .env). Placeholders only.
NODE_ENV=development
PORT=3000

# Origin of the web frontend (used for CORS + CSRF origin checks). Same-origin deployment recommended.
APP_ORIGIN=http://localhost:5173

# Neon POOLED connection string (host contains "-pooler"). Used by the running application.
DATABASE_URL=postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<db>?sslmode=require
# Neon DIRECT connection string (no "-pooler"). Used by prisma migrate / seed.
DIRECT_URL=postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<db>?sslmode=require

# At least 32 random characters, e.g.: openssl rand -base64 48
SESSION_SECRET=<generate-a-long-random-value>
SESSION_COOKIE_NAME=cims.sid
SESSION_TTL_HOURS=8
BUSINESS_TIMEZONE=Asia/Kolkata

LOG_LEVEL=info
# Number of reverse-proxy hops to trust (0 = none). Set to 1 behind a single proxy (Render, Railway, ...).
TRUST_PROXY=0
SWAGGER_ENABLED=true

# Separation of duties: only STOREKEEPER may record issues unless this is set to true.
ALLOW_ADMIN_ISSUE=false

# Login rate limit (per IP)
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15

# --- One-time bootstrap of the first ADMIN (npm run admin:create) ---
# ADMIN_EMPLOYEE_CODE=
# ADMIN_FULL_NAME=
# ADMIN_EMAIL=
# ADMIN_BOOTSTRAP_PASSWORD=   (or omit to be prompted interactively)

# --- Demo seed (fictional data; refused in production) ---
# SEED_DEMO_PASSWORD=         (>= 12 chars; shared by all demo accounts)

# --- Tests: MUST be a dedicated database whose name ends in _test ---
# TEST_DATABASE_URL=postgresql://<user>:<password>@127.0.0.1:5432/cims_test
# ALLOW_REMOTE_TEST_DB=false  (set true only for a dedicated Neon test branch/database)
